"use strict";
var table = document.querySelector("table");
var tHead = table.querySelector("thead");
var tBody = table.querySelector("tbody");
var employeeForm = document.createElement("form");
employeeForm.classList.add("new-employee-form");
var fields = [
    {
        label: "Name",
        type: "text",
        name: "name"
    },
    {
        label: "Position",
        type: "text",
        name: "position"
    },
    {
        label: "Office",
        name: "office",
        type: "select",
        options: [
            "Tokyo",
            "Singapore",
            "London",
            "New York",
            "Edinburgh",
            "San Francisco"
        ]
    },
    {
        label: "Salary",
        type: "number",
        name: "salary"
    },
    {
        label: "Age",
        type: "number",
        name: "age"
    }
];
fields.forEach(function(field) {
    var label = document.createElement("label");
    label.textContent = "".concat(field.label, ": ");
    var input;
    if (field.type === "select") {
        input = document.createElement("select");
        field.options.forEach(function(optionValue) {
            var option = document.createElement("option");
            option.value = optionValue;
            option.textContent = optionValue;
            input.appendChild(option);
        });
    } else {
        input = document.createElement("input");
        input.type = field.type;
    }
    input.name = field.name;
    input.setAttribute("data-qa", field.name);
    input.required = true;
    label.appendChild(input);
    employeeForm.appendChild(label);
});
var btn = document.createElement("button");
btn.type = "submit";
btn.textContent = "Save to table";
employeeForm.appendChild(btn);
document.body.appendChild(employeeForm);
tBody.addEventListener("click", function(e) {
    var currentRow = e.target.closest("tr");
    if (currentRow) {
        var activeRow = tBody.querySelector(".active");
        if (activeRow) activeRow.classList.remove("active");
        currentRow.classList.add("active");
    }
});
function showNotification(type, message) {
    var notification = document.createElement("div");
    notification.classList.add("notification", type);
    notification.textContent = message;
    notification.setAttribute("data-qa", "notification");
    document.body.appendChild(notification);
    setTimeout(function() {
        return notification.remove();
    }, 3000);
}
employeeForm.addEventListener("submit", function(e) {
    e.preventDefault();
    var employeeName = employeeForm.elements.name.value;
    var age = Number(employeeForm.elements.age.value);
    var position = employeeForm.elements.position.value;
    var office = employeeForm.elements.office.value;
    var salary = employeeForm.elements.salary.value;
    if (employeeName.length < 4) {
        showNotification("error", "Name must be at least 4 characters long.");
        return;
    }
    if (age < 18 || age > 90) {
        showNotification("error", "Age must be between 18 and 90.");
        return;
    }
    var newRow = tBody.insertRow();
    newRow.innerHTML = "\n    <td>".concat(employeeName, "</td>\n    <td>").concat(position, "</td>\n    <td>").concat(office, "</td>\n    <td>").concat(age, "</td>\n    <td>$").concat(Number(salary).toLocaleString(), "</td>\n  ");
    showNotification("success", "Employee added successfully!");
    employeeForm.reset();
});
var headers = tHead.querySelectorAll("th");
var sortDirection = true;
var lastIndex = -1;
headers.forEach(function(header, index) {
    header.style.cursor = "pointer";
    header.addEventListener("click", function() {
        var rowsArray = Array.from(tBody.rows);
        if (lastIndex === index) sortDirection = !sortDirection;
        else sortDirection = true;
        rowsArray.sort(function(rowA, rowB) {
            var clean = function(str) {
                return str.replace(/[$,]/g, "");
            };
            var cellA = rowA.cells[index].textContent.trim();
            var cellB = rowB.cells[index].textContent.trim();
            var valA = clean(cellA);
            var valB = clean(cellB);
            if (valA !== "" && !isNaN(valA) && valB !== "" && !isNaN(valB)) return sortDirection ? Number(valA) - Number(valB) : Number(valB) - Number(valA);
            return sortDirection ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
        });
        rowsArray.forEach(function(row) {
            return tBody.appendChild(row);
        });
        lastIndex = index;
    });
});
tBody.addEventListener("dblclick", function(e) {
    var cell = e.target.closest("td");
    if (!cell || cell.querySelector("input")) return;
    var originalValue = cell.textContent;
    var input = document.createElement("input");
    input.classList.add("cell-input");
    input.value = originalValue;
    cell.textContent = "";
    cell.appendChild(input);
    input.focus();
    var save = function() {
        var newValue = input.value.trim();
        cell.textContent = newValue !== "" ? newValue : originalValue;
    };
    input.addEventListener("blur", save);
    input.addEventListener("keydown", function(evt) {
        if (evt.key === "Enter") save();
    });
});

